{
  "acp.agents": {
    "Auggie (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "auggie", "--acp"]
    },
    "Copilot (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "copilot", "--acp", "--stdio"]
    },
    "Factory Droid (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "droid", "exec", "--output-format", "acp"]
    },
    "Goose (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "goose", "acp"]
    },
    "Kiro (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "kiro-cli", "acp"]
    },
    "OpenCode (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "opencode", "acp"]
    },
    "Qwen (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "qwen", "--acp"]
    },
    "Vibe (Aicage)": {
      "command": "aicage",
      "args": ["--acp-wsl", "-e", "AICAGE_ENTRYPOINT_CMD=vibe-acp", "--", "vibe"]
    },
    "Amp (Aicage)": {
      "command": "amp-acp",
      "env": {
        "CODEX_PATH": "aicage-amp.cmd"
      }
    },
    "Claude (Aicage)": {
      "command": "claude-agent-acp",
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "aicage-claude.cmd"
      }
    },
    "Codex (Aicage)": {
      "command": "codex-acp",
      "env": {
        "CODEX_PATH": "aicage-codex.cmd"
      }
    }
  }
}
