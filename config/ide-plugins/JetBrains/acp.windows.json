{
  "default_mcp_settings": {},
  "agent_servers": {
    "Auggie (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "auggie", "--acp"]
    },
    "Copilot (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "copilot", "--acp", "--stdio"]
    },
    "Factory Droid (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "droid", "exec", "--output-format", "acp"]
    },
    "Goose (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "goose", "acp"]
    },
    "Kiro (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "kiro-cli", "acp"]
    },
    "OpenCode (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "opencode", "acp"]
    },
    "Qwen (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "qwen", "--acp"]
    },
    "Vibe (Aicage)": {
      "command": "/path/to/aicage",
      "args": ["--acp-wsl", "-e", "AICAGE_ENTRYPOINT_CMD=vibe-acp", "--", "vibe"]
    },
    "Amp (Aicage)": {
      "command": "/path/to/amp-acp.cmd",
      "env": {
        "CODEX_PATH": "aicage-amp"
      }
    },
    "Claude (Aicage)": {
      "command": "/path/to/claude-agent-acp.cmd",
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "aicage-claude"
      }
    },
    "Codex (Aicage)": {
      "command": "/path/to/codex-acp.cmd",
      "env": {
        "CODEX_PATH": "aicage-codex"
      }
    }
  }
}
